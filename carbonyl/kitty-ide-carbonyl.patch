+/// Turn what the user typed in the address bar into something Chromium can load,
+/// the way a browser omnibox does: keep anything that already has a scheme,
+/// assume `https://` for a bare host like `youtube.com`, and send everything
+/// else to a search engine. Without this, typing `youtube.com` and pressing
+/// Return does nothing, because the raw string isn't a valid URL.
+fn resolve_url(input: &str) -> String {
+    let trimmed = input.trim();
+
+    if trimmed.is_empty() {
+        return "about:blank".to_owned();
+    }
+
+    // Already a full URL or a special scheme: load it verbatim.
+    if trimmed.contains("://")
+        || trimmed.starts_with("about:")
+        || trimmed.starts_with("data:")
+        || trimmed.starts_with("file:")
+    {
+        return trimmed.to_owned();
+    }
+
+    // A bare host such as `youtube.com`, `localhost` or `localhost:3000`.
+    let host = trimmed.split(['/', '?', '#']).next().unwrap_or(trimmed);
+    let host_only = host.split(':').next().unwrap_or(host);
+    let looks_like_host =
+        !trimmed.contains(' ') && (host_only.contains('.') || host_only == "localhost");
+
+    if looks_like_host {
+        format!("https://{trimmed}")
+    } else {
+        format!("https://duckduckgo.com/?q={}", percent_encode(trimmed))
+    }
+}
+
+/// Percent-encode a search query for use in a URL.
+fn percent_encode(input: &str) -> String {
+    let mut out = String::with_capacity(input.len());
+
+    for byte in input.bytes() {
+        match byte {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => {
+                out.push(byte as char)
+            }
+            b' ' => out.push('+'),
+            _ => out.push_str(&format!("%{byte:02X}")),
+        }
+    }
+
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{resolve_url, Navigation};
+    use crate::input::Key;
+
+    fn nav_with(url: &str) -> Navigation {
+        let mut nav = Navigation::new();
+        nav.push(url, false, false);
+        nav
+    }
+
+    fn click(nav: &mut Navigation, x: i32) {
+        nav.mouse_down((x, 0).into());
+        nav.mouse_up((x, 0).into());
+    }
+
+    #[test]
+    fn click_focuses_and_selects_all() {
+        let mut nav = nav_with("https://example.com");
+
+        click(&mut nav, 15);
+        assert_eq!(nav.selected_text().as_deref(), Some("https://example.com"));
+    }
+
+    #[test]
+    fn second_click_places_caret() {
+        let mut nav = nav_with("https://example.com");
+
+        click(&mut nav, 15);
+        click(&mut nav, 13); // col 13 - 11 = char index 2
+        assert_eq!(nav.selected_text(), None);
+        assert_eq!(nav.cursor().map(|p| p.x), Some(13));
+    }
+
+    #[test]
+    fn typing_replaces_selection() {
+        let mut nav = nav_with("https://example.com");
+
+        click(&mut nav, 15); // select all
+        nav.keypress(&Key::from(b'x'));
+        assert_eq!(nav.display_url(), "x");
+    }
+
+    #[test]
+    fn drag_selects_range() {
+        let mut nav = nav_with("https://example.com");
+
+        click(&mut nav, 15); // focus
+        nav.mouse_down((11, 0).into());
+        nav.mouse_move((16, 0).into());
+        nav.mouse_up((16, 0).into());
+        assert_eq!(nav.selected_text().as_deref(), Some("https"));
+    }
+
+    #[test]
+    fn ctrl_a_selects_all_backspace_clears() {
+        let mut nav = nav_with("https://example.com");
+
+        click(&mut nav, 15);
+        click(&mut nav, 13);
+        nav.keypress(&Key::from(0x01));
+        nav.keypress(&Key::from(0x7f));
+        assert_eq!(nav.display_url(), "");
+    }
+
+    #[test]
+    fn control_chars_are_not_inserted() {
+        let mut nav = nav_with("abc");
+
+        click(&mut nav, 15);
+        click(&mut nav, 12);
+        nav.keypress(&Key::from(0x03));
+        nav.keypress(&Key::from(0x1b));
+        assert_eq!(nav.display_url(), "abc");
+    }
+
+    #[test]
+    fn paste_inserts_at_caret() {
+        let mut nav = nav_with("ac");
+
+        click(&mut nav, 15);
+        click(&mut nav, 12); // caret at char 1
+        assert!(nav.insert_text("b"));
+        assert_eq!(nav.display_url(), "abc");
+    }
+
+    #[test]
+    fn ctrl_o_opens_external_with_current_url() {
+        use super::NavigationAction;
+
+        let mut nav = nav_with("https://example.com");
+
+        // Unfocused and focused both hand off the displayed URL.
+        for _ in 0..2 {
+            match nav.keypress(&Key::from(0x0f)) {
+                NavigationAction::OpenExternal(url) => {
+                    assert_eq!(url, "https://example.com")
+                }
+                _ => panic!("expected OpenExternal"),
+            }
+            click(&mut nav, 15);
+        }
+    }
+
+    #[test]
+    fn keeps_full_urls() {
+        assert_eq!(resolve_url("https://youtube.com"), "https://youtube.com");
+        assert_eq!(resolve_url("http://example.com/x"), "http://example.com/x");
+        assert_eq!(resolve_url("about:blank"), "about:blank");
+        assert_eq!(resolve_url("file:///etc/hosts"), "file:///etc/hosts");
+    }
+
+    #[test]
+    fn assumes_https_for_bare_hosts() {
+        assert_eq!(resolve_url("youtube.com"), "https://youtube.com");
+        assert_eq!(
+            resolve_url("youtube.com/watch?v=1"),
+            "https://youtube.com/watch?v=1"
+        );
+        assert_eq!(resolve_url("localhost"), "https://localhost");
+        assert_eq!(resolve_url("localhost:3000"), "https://localhost:3000");
+        assert_eq!(resolve_url("  arxiv.org  "), "https://arxiv.org");
+    }
+
+    #[test]
+    fn searches_plain_text() {
+        assert_eq!(
+            resolve_url("hello world"),
+            "https://duckduckgo.com/?q=hello+world"
+        );
+        assert_eq!(resolve_url("rust"), "https://duckduckgo.com/?q=rust");
+    }
+
+    #[test]
+    fn empty_is_blank() {
+        assert_eq!(resolve_url("   "), "about:blank");
+    }
+}
