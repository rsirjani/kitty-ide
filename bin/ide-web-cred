#!/usr/bin/env bash
# Manage web credentials for the in-terminal browser's Ctrl+L autofill.
#
# Secrets live in the system keyring (gnome-keyring) via secret-tool, keyed by
# exact host: service=carbonyl, domain=<host>, field=username|password.
# carbonyl looks them up only on an explicit Ctrl+L, only for the exact host of
# the current page — a look-alike domain never matches.
#
#   ide-web-cred add  <host> [username]   store credentials (prompts for both)
#   ide-web-cred show <host>              show username / whether password set
#   ide-web-cred rm   <host>              remove stored credentials
#   ide-web-cred ls                       list hosts with stored credentials
set -euo pipefail

die() { echo "$*" >&2; exit 2; }
command -v secret-tool >/dev/null || die "secret-tool not found (install libsecret)"

cmd=${1:-}
case "$cmd" in
  add)
    host=${2:-}; [ -n "$host" ] || die "usage: ide-web-cred add <host> [username]"
    user=${3:-}
    [ -n "$user" ] || read -rp "username for $host: " user
    read -rsp "password for $host: " pw; echo
    [ -n "$pw" ] || die "empty password, nothing stored"
    printf '%s' "$user" | secret-tool store --label="carbonyl $host (username)" \
      service carbonyl domain "$host" field username
    printf '%s' "$pw" | secret-tool store --label="carbonyl $host (password)" \
      service carbonyl domain "$host" field password
    echo "stored credentials for $host (fill with Ctrl+L on that site)"
    ;;
  show)
    host=${2:-}; [ -n "$host" ] || die "usage: ide-web-cred show <host>"
    echo "username: $(secret-tool lookup service carbonyl domain "$host" field username 2>/dev/null || echo '<none>')"
    if secret-tool lookup service carbonyl domain "$host" field password >/dev/null 2>&1; then
      echo "password: <set>"
    else
      echo "password: <none>"
    fi
    ;;
  rm)
    host=${2:-}; [ -n "$host" ] || die "usage: ide-web-cred rm <host>"
    secret-tool clear service carbonyl domain "$host" field username 2>/dev/null || true
    secret-tool clear service carbonyl domain "$host" field password 2>/dev/null || true
    echo "cleared credentials for $host"
    ;;
  ls)
    # secret-tool search prints one block per match; pull the domain attribute.
    secret-tool search --all service carbonyl 2>/dev/null \
      | sed -n 's/^attribute.domain = //p' | sort -u
    ;;
  *)
    die "usage: ide-web-cred add|show|rm <host> | ls"
    ;;
esac
