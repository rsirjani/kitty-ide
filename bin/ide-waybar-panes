#!/usr/bin/env python3
# Waybar buttons that minimize / restore the IDE panes (explorer, vd, files).
#
# The buttons only exist on a bar whose monitor is showing a workspace with a
# kitty IDE on it. With one IDE there, each button toggles that pane. With two
# or more, each button is a drawer: click it and it slides open a list of the
# IDEs (by chat title), and each entry toggles that pane in that IDE.
#
#   ide-waybar-panes daemon              the one poller (started by Waybar)
#   ide-waybar-panes click <pane> [n]    a button was clicked (n = drawer entry)
#   ide-waybar-panes config              print the Waybar module definitions
#
# Waybar has no dynamic module lists, so the drawer entries are a fixed set of
# slots (SLOTS per pane) that stay hidden while empty. Rather than run a poller
# per module per bar (3 panes x (1 + SLOTS) x bars), ONE daemon works out what
# every module on every bar should show and writes it under
#   $XDG_RUNTIME_DIR/ide-waybar/<output>/<pane>[-<n>]
# then pokes Waybar (SIGRTMIN+SIGNAL); each module's `exec` is just a `cat` of
# its file. The daemon is itself a (permanently empty) Waybar module, so it
# lives and dies with the bar; every bar starts a copy and flock keeps one.
#
# Pane state comes from /tmp/ide-<pid>-shown-<pane>, maintained by the layout
# hook in kitty/ide-min.py; <pid> is the kitty pid == the Hyprland window pid.
import fcntl, json, os, re, signal, subprocess, sys, time

PANES = ("explorer", "vd", "files")
ICON = {"explorer": "\U000F0645", "vd": "\U000F0379", "files": "\U000F0219"}
NAME = {"explorer": "Explorer", "vd": "Virtual desktop", "files": "Files"}
SLOTS = 4
SIGNAL = 12
POLL = 0.5
ROOT = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ide-waybar")
SPIN_RE = re.compile(r"^[⠀-⣿✳✶✷✻◐-◓·•✱\s]+")   # Claude's animated title prefix


def run(*a, timeout=2):
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def hypr(what):
    try:
        return json.loads(run("hyprctl", what, "-j") or "null") or []
    except Exception:
        return []


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def shown(pid, pane):
    return os.path.exists(f"/tmp/ide-{pid}-shown-{pane}")


def ides_by_output():
    """{output name: [kitty pid, …]} for the IDEs on each monitor's active
    workspace, ordered left-to-right then top-to-bottom."""
    clients = hypr("clients")
    out = {}
    for m in hypr("monitors"):
        ws = (m.get("activeWorkspace") or {}).get("id")
        wins = [c for c in clients
                if c.get("class") == "ide" and (c.get("workspace") or {}).get("id") == ws
                and c.get("pid") and os.path.exists(f"/tmp/ide.sock-{c['pid']}")]
        wins.sort(key=lambda c: tuple(c.get("at") or (0, 0)))
        out[m.get("name", "")] = [c["pid"] for c in wins]
    return out


def chat_title(pid):
    """The IDE's Claude chat title (as ide-waybar-window shows it), or ''."""
    try:
        data = json.loads(run("kitty", "@", "--to", f"unix:/tmp/ide.sock-{pid}", "ls"))
    except Exception:
        return ""
    for w in data:
        for t in w.get("tabs", []):
            for win in t.get("windows", []):
                if win.get("user_vars", {}).get("pane") != "claude":
                    continue
                title = SPIN_RE.sub("", win.get("title") or "").strip()
                return "" if title.lower() in ("", "claude", "zsh") else title
    return ""


def module(text, cls, tooltip):
    return json.dumps({"text": text, "class": ["ide-pane", *cls], "tooltip": tooltip},
                      ensure_ascii=False) + "\n"


def render(pids, titles):
    """{file name: contents} for one output. An empty string hides the module."""
    files = {}
    for pane in PANES:
        for n in range(1, SLOTS + 1):
            files[f"{pane}-{n}"] = ""
        if not pids:
            files[pane] = ""
        elif len(pids) == 1:
            on = shown(pids[0], pane)
            files[pane] = module(ICON[pane], ["open" if on else "min"],
                                 f"{NAME[pane]} — click to {'minimize' if on else 'open'}")
        else:
            states = [shown(p, pane) for p in pids]
            files[pane] = module(ICON[pane], ["multi", "open" if any(states) else "min"],
                                 f"{NAME[pane]} — {len(pids)} IDEs here, click to pick one")
            for n, (pid, on) in enumerate(list(zip(pids, states))[:SLOTS], 1):
                title = titles.get(pid) or f"IDE {n}"
                short = title if len(title) <= 22 else title[:21] + "…"
                files[f"{pane}-{n}"] = module(
                    f"{n} {esc(short)}", ["entry", "open" if on else "min"],
                    f"{NAME[pane]} in “{esc(title)}” — click to {'minimize' if on else 'open'}")
    return files


def daemon():
    os.makedirs(ROOT, exist_ok=True)
    lock = open(os.path.join(ROOT, "lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)            # one poller; the rest wait here
    with open(os.path.join(ROOT, "pid"), "w") as f:
        f.write(str(os.getpid()))
    wake = {"now": False}
    signal.signal(signal.SIGUSR1, lambda *_: wake.__setitem__("now", True))
    written, titles, titles_at = {}, {}, 0.0
    time.sleep(1.0)       # let Waybar finish starting before the first signal
    while True:
        by_out = ides_by_output()
        crowded = {p for pids in by_out.values() if len(pids) > 1 for p in pids}
        if crowded and (time.monotonic() - titles_at > 2.0 or not crowded <= titles.keys()):
            titles = {p: chat_title(p) for p in crowded}
            titles_at = time.monotonic()
        changed = False
        for out, pids in by_out.items():
            d = os.path.join(ROOT, out)
            os.makedirs(d, exist_ok=True)
            for name, body in render(pids, titles).items():
                if written.get((out, name)) != body:
                    tmp = os.path.join(d, f".{name}.tmp")
                    with open(tmp, "w") as f:
                        f.write(body)
                    os.replace(tmp, os.path.join(d, name))
                    written[(out, name)] = body
                    changed = True
        state = json.dumps(by_out)
        if written.get("state") != state:
            tmp = os.path.join(ROOT, ".state.tmp")
            with open(tmp, "w") as f:
                f.write(state)
            os.replace(tmp, os.path.join(ROOT, "state.json"))
            written["state"] = state
        if changed:
            subprocess.run(["pkill", f"-RTMIN+{SIGNAL}", "-x", "waybar"])
        # sleep, but return at once when a click asks for a refresh
        end = time.monotonic() + POLL
        while not wake["now"] and time.monotonic() < end:
            time.sleep(0.05)
        if wake["now"]:
            wake["now"] = False
            time.sleep(0.12)                    # let kitty apply the toggle first


def output_under_cursor():
    try:
        x, y = (int(v) for v in run("hyprctl", "cursorpos").replace(",", " ").split()[:2])
    except Exception:
        return ""
    for m in hypr("monitors"):
        w, h = m["width"] / m.get("scale", 1), m["height"] / m.get("scale", 1)
        if m.get("transform", 0) % 2:
            w, h = h, w
        if m["x"] <= x < m["x"] + w and m["y"] <= y < m["y"] + h:
            return m["name"]
    return ""


def click(pane, slot):
    if pane not in PANES:
        return
    try:
        state = json.load(open(os.path.join(ROOT, "state.json")))
    except Exception:
        return
    pids = state.get(os.environ.get("WAYBAR_OUTPUT_NAME") or output_under_cursor(), [])
    if slot is None:
        if len(pids) != 1:
            return          # several IDEs: the button only opens its drawer
        pid = pids[0]
    elif 1 <= slot <= len(pids):
        pid = pids[slot - 1]
    else:
        return
    # Waybar's PATH has no ~/.local/bin, so call the sibling script by path.
    here = os.path.dirname(os.path.realpath(__file__))
    subprocess.run([os.path.join(here, "ide-min"), "--pid", str(pid), "toggle", pane])
    try:
        os.kill(int(open(os.path.join(ROOT, "pid")).read()), signal.SIGUSR1)
    except Exception:
        pass


def config():
    """The module definitions, to be included from the Waybar config."""
    me = os.path.join(os.path.expanduser("~"), ".local", "bin", "ide-waybar-panes")
    mods = {"custom/ide-panes": {"exec": f"{me} daemon", "restart-interval": 5,
                                 "format": "{}", "tooltip": False}}
    for pane in PANES:
        names = [f"custom/ide-{pane}"] + [f"custom/ide-{pane}-{n}" for n in range(1, SLOTS + 1)]
        mods[f"group/ide-{pane}"] = {
            "orientation": "inherit",
            "drawer": {"transition-duration": 220, "transition-left-to-right": True,
                       "click-to-reveal": True, "children-class": "ide-pane-entry"},
            "modules": names,
        }
        for i, name in enumerate(names):
            f = pane if i == 0 else f"{pane}-{i}"
            mods[name] = {
                "format": "{}", "return-type": "json", "interval": "once", "signal": SIGNAL,
                "exec": f'cat "$XDG_RUNTIME_DIR/ide-waybar/$WAYBAR_OUTPUT_NAME/{f}" 2>/dev/null',
                "on-click": f"{me} click {pane}" + (f" {i}" if i else ""),
            }
    print(json.dumps(mods, indent=2, ensure_ascii=False))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "daemon":
        daemon()
    elif cmd == "click" and len(sys.argv) > 2:
        click(sys.argv[2], int(sys.argv[3]) if len(sys.argv) > 3 else None)
    elif cmd == "config":
        config()
    else:
        sys.exit(__doc__ or "usage: ide-waybar-panes daemon | click <pane> [n] | config")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
