#!/usr/bin/env bash
# Rendered Markdown view for the IDE editor pane.
#
# glow's own pager (`glow -p`) exits immediately when kitty launches it inside an
# overlay (the TUI bails before it can take over the screen), so the tab would
# vanish. Instead we render with glow and page the result through `less` ourselves
# -- which reliably stays open. Press q to close the tab; Alt+M (or the tab-bar ⇄)
# morphs to nvim for editing.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
file="$1"
[ -n "$file" ] || exit 0
cols=$(tput cols 2>/dev/null || echo 100)

# Prefer a real KaTeX render in Carbonyl. This supports the full notation used
# in mathematical Markdown (including \mathcal, \operatorname, fractions,
# aligned scripts, and accessible MathML) instead of approximating it as text.
renderer="$(dirname "$(readlink -f "$0")")/ide-render-md.js"
if command -v node >/dev/null 2>&1 && command -v carbonyl >/dev/null 2>&1 \
   && [ -r "$renderer" ]; then
  . ide-sock 2>/dev/null || true
  html_dir="/tmp/ide-${IDE_ID:-default}-render"
  mkdir -p "$html_dir"
  key="$(printf '%s|%s' "$(readlink -f -- "$file")" \
    "$(stat -c %Y -- "$file" 2>/dev/null || echo 0)" | md5sum | cut -d' ' -f1)"
  html="$html_dir/md-$key.html"
  if node "$renderer" "$file" "$html" && [ -s "$html" ]; then
    exec carbonyl --graphics --user-data-dir="$html_dir/chromium-$$" "file://$html"
  fi
fi

# mdterm provides partial LaTeX-to-Unicode conversion when the HTML renderer is
# unavailable. glow remains the final, widely available fallback below.
if command -v mdterm >/dev/null 2>&1; then
  exec mdterm --theme dark --width "$cols" "$file"
fi

# Cache glow's rendered output keyed by abspath+mtime+width, so re-opening the
# same (unchanged) markdown is instant instead of re-rendering each time. The
# cache lives under this instance's /tmp render dir, which `ide` cleans on exit.
. ide-sock 2>/dev/null || true
cache_dir="/tmp/ide-${IDE_ID:-default}-render"; mkdir -p "$cache_dir" 2>/dev/null || true
# Split the key: a per-file hash + a per-version (mtime+width) hash, so we can
# prune older renders of the same file before writing the new one (bounds growth
# within a session).
pathhash="$(printf '%s' "$(readlink -f -- "$file" 2>/dev/null || echo "$file")" | md5sum | cut -d' ' -f1)"
verhash="$(printf '%s|%s' "$(stat -c %Y -- "$file" 2>/dev/null || echo 0)" "$cols" | md5sum | cut -d' ' -f1)"
cache="$cache_dir/md-$pathhash-$verhash.ansi"

# -s dark: match the IDE's dark theme · -w: wrap to the pane width · less -R: keep
# glow's ANSI colours. LESS=-R also avoids a stray "missing filename" if glow fails.
#
# glow (termenv) silently drops its colours whenever stdout is not a TTY — and
# here it never is (we render into the cache file), so the view came out as bare
# bold/underline text. Run glow under a pty via script(1) so it keeps the
# style's full colours.
#
# On that pty termenv probes the terminal (OSC 10/11 fg/bg + CSI 6n cursor, the
# 6n acting as a fence) and BLOCKS ~5s per unanswered probe — 15s of blank tab.
# Nothing sits on the other side to answer, so we pre-feed one cursor-position
# reply per probe through script's stdin: termenv reads the fence reply and
# moves on instantly. The sed then strips the pty's \r line endings and all the
# probe/reply bytes (replaying probes through less would make kitty answer them,
# feeding stray input into less).
render_md() {
  if command -v script >/dev/null 2>&1; then
    printf '\033[1;1R\033[1;1R\033[1;1R' \
      | script -qec "$(printf '%q ' glow -s dark -w "$cols" -- "$file")" /dev/null 2>/dev/null \
      | sed -e 's/\r$//' -e 's/\x1b\[1;1R//g' -e 's/\^\[\[1;1R//g' \
            -e 's/\x1b\[6n//g' -e 's/\x1b]1[01];?\x1b\\//g' -e '1{/^$/d}'
  else
    CLICOLOR_FORCE=1 glow -s dark -w "$cols" -- "$file" 2>/dev/null   # 16-colour fallback
  fi
}
if [ ! -s "$cache" ]; then
  rm -f "$cache_dir/md-$pathhash-"*.ansi 2>/dev/null || true   # drop stale renders of this file
  # Render to a temp then atomically rename, so a concurrent viewer never reads
  # a half-written cache (and two renders of the same key can't clobber).
  tmp="$cache.$$.tmp"
  render_md > "$tmp"
  if [ -s "$tmp" ]; then
    mv -f "$tmp" "$cache"
  else
    rm -f "$tmp"
  fi
fi
if [ -s "$cache" ]; then less -R -- "$cache"
else render_md | less -R; fi
