#!/usr/bin/env bash
# Manually point the IDE explorer at a remote filesystem (or bring it back).
#
#   ide-remote [user@]host[:port]   sshfs-mount + follow in the explorer
#   ide-remote off                  restore the local explorer
#   ide-remote                      print the current override
#
# Writes an override consumed by ide-remote-follow. Useful when no ssh is
# visible in the claude pane's foreground: Claude Code running ssh through its
# Bash tool (tool processes are detached from the pane's tty, so `kitty @ ls`
# never lists them), one-shot `ssh host cmd` loops, or a session inside tmux.
# Auth is still non-interactive: keys, or a live multiplexed master
# (ControlMaster) from any interactive session to that host.
export PATH="$HOME/.local/bin:$PATH"
. ide-sock                   # -> IDE_ID for THIS instance
f="/tmp/ide-${IDE_ID}-remote-dest"
case "${1:-}" in
  "")           cat "$f" 2>/dev/null || echo "(none)" ;;
  off|-|local)  rm -f "$f" ;;
  *)            printf '%s' "$1" >"$f" ;;
esac
